---
import "../styles/maximal.css";
const skills = [
  {
    number: "01",
    name: "Frontend",
    phrase: "Se ve. Se siente. Funciona.",
    text: "Interfaces responsive y componentes reutilizables que convierten requerimientos en experiencias claras.",
    stack: "Angular / TypeScript / HTML / CSS",
    class: "front",
  },
  {
    number: "02",
    name: "Backend",
    phrase: "La magia tiene lógica.",
    text: "APIs REST, servicios e integraciones entre aplicaciones, bases de datos y hardware.",
    stack: "Node.js / NestJS / Java / PHP / SQL",
    class: "back",
  },
  {
    number: "03",
    name: "Infraestructura",
    phrase: "Ideas listas para operar.",
    text: "Despliegue y mantenimiento de aplicaciones y datos en Linux, con contenedores y procesos CI/CD.",
    stack: "Linux / Docker / Jenkins / CI/CD",
    class: "infra",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#fc693b" />
    <meta
      name="description"
      content="Jhon Rengifo. Desarrollador full stack e ingeniero de sistemas en Colombia. Interfaces, APIs e infraestructura: ideas convertidas en software."
    />
    <link rel="icon" href="/creative-mark.svg" type="image/svg+xml" />
    <title>Jhon Rengifo — Ideas grandes. Software real.</title>
  </head>
  <body>
    <a class="skip-link" href="#trabajo">
      Saltar al contenido
    </a>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Jhon Rengifo, inicio">
        jhon<span class="brand-star">✳</span>
      </a>
      <nav id="site-nav" aria-label="Principal">
        <a href="#trabajo">Trabajo</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#capacidades">Capacidades</a>
        <a href="#contacto">Contacto ↗</a>
      </nav>
      <div class="header-tools">
        <a
          class="cv-link"
          href="/cv_mejorada.pdf"
          target="_blank"
          rel="noopener"
        >
          CV ↗
        </a>
        <button
          id="motion-toggle"
          aria-pressed="false"
          aria-label="Pausar animaciones"
        >
          ◫ <span>Movimiento</span>
        </button>
        <button id="menu-toggle" aria-expanded="false" aria-controls="site-nav">
          Menú +
        </button>
      </div>
    </header>
    <main>
      <section class="max-hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-kicker">
          <span>
            <i></i> JHON RENGIFO — SOFTWARE DEVELOPER
          </span>
          <span>TULUÁ, COLOMBIA / PORTAFOLIO 2026</span>
        </div>
        <div class="hero-composition">
          <h1 id="hero-title">
            <span class="title-line">IDEAS</span>
            <span class="title-line title-outline">GRANDES.</span>
            <span class="title-line title-small">
              SOFTWARE <em>REAL.</em>
            </span>
          </h1>
          <div class="creative-object" id="creative-object">
            <div class="object-fallback" aria-hidden="true">
              ✳
            </div>
            <div id="creative-canvas" aria-hidden="true"></div>
            <span class="object-label">CREATIVE SYSTEM / 001</span>
          </div>
          <span class="hero-sticker sticker-lime">
            DEL PIXEL
            <br />
            AL SERVIDOR. <b>↗</b>
          </span>
          <button class="remix" id="remix" aria-pressed="false">
            <span>✳</span> REMEZCLA
            <br />
            EL SISTEMA <b>↗</b>
          </button>
        </div>
        <div class="hero-foot">
          <p>
            Soy <strong>Jhon</strong>, ingeniero de sistemas y desarrollador
            full stack. Conecto interfaces, servicios y datos para convertir
            problemas complejos en software que funciona.
          </p>
          <div class="hero-actions">
            <a class="action dark" href="#trabajo">
              Explorar mi trabajo <span>↘</span>
            </a>
            <a
              class="underlined"
              href="/cv_mejorada.pdf"
              target="_blank"
              rel="noopener"
            >
              Conoce mi trayectoria ↗
            </a>
          </div>
          <span class="hero-index">
            SCROLL PARA
            <br />
            CONECTAR LAS PIEZAS ↓
          </span>
        </div>
      </section>
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          FRONTEND <span>✳</span> BACKEND <span>✳</span> INFRAESTRUCTURA{" "}
          <span>✳</span> IDEAS EN MOVIMIENTO <span>✳</span> FRONTEND{" "}
          <span>✳</span> BACKEND <span>✳</span> INFRAESTRUCTURA <span>✳</span>{" "}
          IDEAS EN MOVIMIENTO <span>✳</span>
        </div>
      </div>
      <section class="work-section" id="trabajo" aria-labelledby="work-heading">
        <div class="section-top">
          <span>01 / TRABAJO DESTACADO</span>
          <span>MENOS PROMESAS. MÁS CONTEXTO.</span>
        </div>
        <div class="section-heading">
          <h2 id="work-heading">
            CÓDIGO CON
            <br />
            <span class="serif-word">propósito.</span>
          </h2>
          <p>
            Experiencia real en sistemas operativos y comercio electrónico.
            <br />
            <strong>Esto es lo que he ayudado a construir.</strong>
          </p>
        </div>
        <div class="work-grid">
          <article class="work-card card-lime">
            <div class="card-header">
              <span>01 / FTSTECNOLOGÍA</span>
              <span class="type-tag">EXPERIENCIA PROFESIONAL</span>
            </div>
            <a
              class="work-title"
              href="/trabajo/auditoria-e-interoperabilidad/"
            >
              <h3>
                SISTEMAS
                <br />
                CONECTADOS.
              </h3>
              <span>↗</span>
            </a>
            <p>
              Auditoría de peajes, control operativo e interoperabilidad. Mi
              participación: desarrollo full stack, APIs e integraciones.
            </p>
            <a
              class="work-art art-system"
              href="/trabajo/auditoria-e-interoperabilidad/"
              aria-label="Ver mi contribución en FTSTecnología"
            >
              <div class="diagram" aria-hidden="true">
                <div class="diagram-lines"></div>
                <span class="diagram-node node-interface">
                  UI <small>INTERFAZ</small>
                </span>
                <span class="diagram-node node-api">{"{ API }"}</span>
                <span class="diagram-node node-data">
                  DB <small>DATOS</small>
                </span>
                <span class="diagram-node node-infra">
                  ↑<small>INFRAESTRUCTURA</small>
                </span>
                <span class="diagram-star">✳</span>
              </div>
              <span class="art-caption">VISUALIZACIÓN CONCEPTUAL</span>
            </a>
            <div class="card-bottom">
              <span>FULL STACK / APIs / DOCKER</span>
              <a href="/trabajo/auditoria-e-interoperabilidad/">
                Ver mi contribución ↗
              </a>
            </div>
          </article>
          <article class="work-card card-blue">
            <div class="card-header">
              <span>02 / OMNI.PRO</span>
              <span class="type-tag">EXPERIENCIA PROFESIONAL</span>
            </div>
            <a class="work-title" href="/trabajo/ecommerce-responsive/">
              <h3>
                COMERCIO.
                <br />
                SIN FRICCIÓN.
              </h3>
              <span>↗</span>
            </a>
            <p>
              Interfaces de e-commerce y componentes responsive sobre Magento 2
              y Adobe Commerce. Mi participación: desarrollo frontend.
            </p>
            <a
              class="work-art art-commerce"
              href="/trabajo/ecommerce-responsive/"
              aria-label="Ver mi contribución en Omni.pro"
            >
              <div class="shop-window" aria-hidden="true">
                <div class="shop-nav">
                  GOOD / OBJECTS <span>MENU +</span>
                </div>
                <div class="shop-title">
                  LESS SCROLL.
                  <br />
                  <i>MORE SOUL.</i>
                </div>
                <div class="shop-sculpture">✳</div>
                <span class="shop-cta">FIND YOUR THING ↗</span>
              </div>
              <span class="sale-sticker" aria-hidden="true">
                WEB
                <br />+ MÓVIL
              </span>
              <span class="art-caption">
                COMPOSICIÓN CONCEPTUAL, NO CAPTURA DE CLIENTE
              </span>
            </a>
            <div class="card-bottom">
              <span>FRONTEND / E-COMMERCE / UI</span>
              <a href="/trabajo/ecommerce-responsive/">Ver mi contribución ↗</a>
            </div>
          </article>
        </div>
      </section>
      <section
        class="capabilities"
        id="capacidades"
        aria-labelledby="cap-heading"
      >
        <div class="section-top">
          <span>02 / CAPACIDADES TÉCNICAS</span>
          <span>TODAS LAS PIEZAS IMPORTAN</span>
        </div>
        <h2 id="cap-heading">
          NO ME QUEDO
          <br />
          EN LA <span>SUPERFICIE.</span>
        </h2>
        <div class="cap-grid">
          {skills.map((skill) => (
            <article class={`cap-card ${skill.class}`}>
              <span class="cap-number">{skill.number}</span>
              <div class="cap-icon" aria-hidden="true">
                {skill.number === "01"
                  ? "↗"
                  : skill.number === "02"
                    ? "✳"
                    : "▥"}
              </div>
              <h3>{skill.name}</h3>
              <strong>{skill.phrase}</strong>
              <p>{skill.text}</p>
              <span class="cap-stack">{skill.stack}</span>
            </article>
          ))}
        </div>
        <div class="system-playground">
          <div>
            <span class="eyebrow">PRUÉBALO / SIMULACIÓN ILUSTRATIVA</span>
            <h3>
              Una idea entra.
              <br />
              Un sistema responde.
            </h3>
            <p>
              Explora cómo colaboran las capas. No se envían datos ni se ejecuta
              un backend real.
            </p>
            <button class="action lime" id="run-system">
              Enviar una idea <span>↗</span>
            </button>
          </div>
          <div class="pipeline">
            <div class="pipeline-stages">
              <span data-stage="0">INTERFAZ</span>
              <b>→</b>
              <span data-stage="1">API</span>
              <b>→</b>
              <span data-stage="2">DATOS</span>
            </div>
            <div class="infra-rail">LINUX + DOCKER / ENTORNO DE EJECUCIÓN</div>
            <p id="system-status" role="status">
              Todo conectado. Listo para comenzar.
            </p>
            <div class="signal-track" aria-hidden="true">
              <span class="signal"></span>
            </div>
          </div>
        </div>
      </section>
      <section
        class="experience-section"
        id="experiencia"
        aria-labelledby="exp-heading"
      >
        <div class="section-top">
          <span>03 / EXPERIENCIA PROFESIONAL</span>
          <span>DEL APRENDIZAJE A LA PRÁCTICA</span>
        </div>
        <div class="experience-layout">
          <div>
            <h2 id="exp-heading">
              NO EMPECÉ
              <br />
              <span class="serif-word">ayer.</span>
            </h2>
            <div class="experience-stamp">
              <strong>4+</strong>
              <span>
                AÑOS DE
                <br />
                EXPERIENCIA
              </span>
              <b>✳</b>
            </div>
          </div>
          <div class="timeline">
            <article>
              <span>2023 — ACTUALIDAD</span>
              <h3>
                FTSTecnología <small>↗</small>
              </h3>
              <strong>Software Developer · Tuluá</strong>
              <p>
                Aplicaciones full stack para auditoría e interoperabilidad.
                APIs, servicios, integración de datos y despliegue de
                aplicaciones.
              </p>
            </article>
            <article>
              <span>2022 — 2023</span>
              <h3>
                Omni.pro <small>↗</small>
              </h3>
              <strong>Frontend Developer · Bogotá</strong>
              <p>
                Desarrollo de interfaces responsive y componentes reutilizables
                para comercio electrónico con Magento 2 y Adobe Commerce.
              </p>
            </article>
            <a
              class="underlined"
              href="/cv_mejorada.pdf"
              target="_blank"
              rel="noopener"
            >
              Ver CV completo ↗
            </a>
          </div>
        </div>
      </section>
      <section class="about-section" aria-labelledby="about-heading">
        <div class="about-poster" aria-hidden="true">
          <span>DETRÁS DEL CÓDIGO</span>
          <strong>
            JHON
            <br />
            RENGIFO
            <span>
              SYSTEMS
              <br />
              ENGINEER.
            </span>
          </strong>
          <div class="poster-symbol">✳</div>
          <small>HECHO EN COLOMBIA ↗</small>
        </div>
        <div class="about-copy">
          <span class="eyebrow">04 / SOBRE MÍ</span>
          <h2 id="about-heading">
            CURIOSIDAD.
            <br />
            CRITERIO.
            <br />
            <em>Y mucho código.</em>
          </h2>
          <p>
            Soy ingeniero de Sistemas de la Universidad del Valle. Me interesa
            entender el problema completo: desde lo que una persona necesita
            hacer hasta la infraestructura que permite hacerlo.
          </p>
          <p>
            Mi experiencia conecta frontend, backend y operación. Creo en las
            soluciones que se pueden explicar, mantener y seguir mejorando.
          </p>
          <div class="about-facts">
            <span>TULUÁ, COLOMBIA</span>
            <span>ESPAÑOL / INGLÉS B1</span>
          </div>
        </div>
      </section>
    </main>
    <footer id="contacto">
      <div class="section-top">
        <span>05 / CONTACTO</span>
        <span>LA PRÓXIMA IDEA PUEDE SER LA TUYA</span>
      </div>
      <a class="footer-cta" href="mailto:rengifo-vera@hotmail.com">
        ¿Y SI LO
        <br />
        <span>CONSTRUIMOS?</span>
        <b>↗</b>
      </a>
      <div class="footer-links">
        <a href="mailto:rengifo-vera@hotmail.com">rengifo-vera@hotmail.com ↗</a>
        <a
          href="https://www.linkedin.com/in/jhon-rengifo-722273217/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>
        <a href="/cv_mejorada.pdf" target="_blank" rel="noopener">
          CV ↗
        </a>
        <a href="#inicio">Volver arriba ↑</a>
      </div>
      <div class="footer-note">
        <span>JHON RENGIFO © {new Date().getFullYear()}</span>
        <span>CREATIVE SYSTEMS / EDICIÓN MAXIMALISTA</span>
      </div>
    </footer>
    <script>
      import "../scripts/maximal";
    </script>
  </body>
</html>
