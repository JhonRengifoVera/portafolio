---
import "../styles/experience.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Jhon Rengifo, desarrollador de software e ingeniero de sistemas. Interfaces, servicios e infraestructura que trabajan juntos."
    />
    <meta name="theme-color" content="#101010" />
    <title>Jhon Rengifo — Software conectado.</title>
  </head>
  <body>
    <a class="skip" href="#trabajo">
      Saltar al contenido
    </a>
    <header class="navigation">
      <a class="wordmark" href="#inicio" aria-label="Jhon Rengifo, inicio">
        jr<span>↗</span>
      </a>
      <span class="nav-role">
        SOFTWARE DEVELOPER
        <br />
        SYSTEMS ENGINEER
      </span>
      <nav aria-label="Principal">
        <a href="#trabajo">Trabajo</a>
        <a href="#sistema">Mi enfoque</a>
        <a href="#contacto">Hablemos ↗</a>
      </nav>
      <button id="motion" aria-pressed="false" aria-label="Pausar movimiento">
        Pausar ◫
      </button>
    </header>
    <main>
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-meta">
          <span>JHON RENGIFO · COLOMBIA</span>
          <span>INTERFACE → INFRASTRUCTURE</span>
        </div>
        <h1 id="hero-title">
          <span>SOFTWARE</span>
          <span class="title-middle">
            QUE <i>CONECTA</i>
          </span>
          <span class="title-last">
            TODO<span class="period">.</span>
          </span>
        </h1>
        <div
          class="sculpture"
          id="sculpture"
          aria-label="Escultura de tres capas conectadas. Usa los controles para separar o girar sus capas."
        >
          <div class="sculpture-fallback" aria-hidden="true">
            <div class="orbit orbit-a"></div>
            <div class="orbit orbit-b"></div>
            <div class="orbit orbit-c"></div>
            <div class="core"></div>
          </div>
          <div id="scene" aria-hidden="true"></div>
          <span class="scene-caption">01 / SISTEMAS CONECTADOS</span>
          <div class="scene-legend" aria-hidden="true">
            <span>Frontend</span>
            <span>Backend</span>
            <span>Infraestructura</span>
          </div>
        </div>
        <div class="hero-bottom">
          <p>
            De lo que ves
            <br />a lo que lo hace posible.
            <br />
            <span>Frontend, backend e infraestructura.</span>
          </p>
          <div class="scene-controls">
            <button id="explode" aria-pressed="false">
              Separar el sistema ↗
            </button>
            <button id="rotate" aria-label="Girar el sistema">
              Girar ↻
            </button>
            <small>ARRASTRA LA PIEZA PARA EXPLORAR</small>
          </div>
          <a class="scroll-link" href="#trabajo">
            Explora mi trabajo <span>↓</span>
          </a>
        </div>
      </section>
      <section class="work" id="trabajo" aria-labelledby="work-title">
        <div class="section-label">
          <h2 id="work-title">EXPERIENCIA EN ACCIÓN</h2>
          <span>2022 — ACTUALIDAD</span>
        </div>
        <article class="project">
          <a
            class="project-stage operations"
            href="/trabajo/auditoria-e-interoperabilidad/"
            aria-label="Explorar experiencia en auditoría e interoperabilidad"
          >
            <div class="project-overline">
              01 — SISTEMAS QUE TRABAJAN JUNTOS
            </div>
            <div class="system-art" aria-hidden="true">
              <div class="system-ring ring-one"></div>
              <div class="system-ring ring-two"></div>
              <div class="system-ring ring-three"></div>
              <div class="system-chip">
                <span>CONNECTED</span>
                <strong>CORE</strong>
                <span>API / DATA / SERVICES</span>
              </div>
              <span class="satellite sat-one">INTERFACE</span>
              <span class="satellite sat-two">DATABASE</span>
              <span class="satellite sat-three">INFRASTRUCTURE</span>
            </div>
            <div class="stage-bottom">
              <p>
                La complejidad,
                <br />
                <em>bien conectada.</em>
              </p>
              <span class="round-arrow">↗</span>
            </div>
            <small class="concept-note">
              INTERPRETACIÓN VISUAL · NO ES UNA CAPTURA DEL PRODUCTO
            </small>
          </a>
          <div class="project-info">
            <div>
              <h3>Auditoría & interoperabilidad</h3>
              <p>FTSTecnología · Desarrollo full stack · Desde 2023</p>
            </div>
            <div class="tags">
              <span>Servicios & APIs</span>
              <span>Datos</span>
              <span>Linux & Docker</span>
            </div>
          </div>
        </article>
        <article class="project">
          <a
            class="project-stage commerce"
            href="/trabajo/ecommerce-responsive/"
            aria-label="Explorar experiencia en comercio electrónico"
          >
            <div class="project-overline">02 — EXPERIENCIAS QUE SE ADAPTAN</div>
            <div class="commerce-art" aria-hidden="true">
              <div class="browser-mock">
                <div class="mock-nav">
                  OBJECT / STUDIO <span>COLLECTION 02 ↗</span>
                </div>
                <div class="mock-heading">
                  Everyday.
                  <br />
                  <i>Extraordinary.</i>
                </div>
                <div class="product-object">
                  <div></div>
                </div>
                <div class="mock-bottom">
                  DESIGNED FOR EVERY DAY <span>EXPLORE →</span>
                </div>
              </div>
              <div class="phone-mock">
                <span>OBJECT /</span>
                <div class="mini-object"></div>
                <strong>
                  Good things.
                  <br />
                  Anywhere.
                </strong>
                <div class="phone-button">EXPLORE ↗</div>
              </div>
            </div>
            <div class="stage-bottom">
              <p>
                Una experiencia.
                <br />
                <em>Cualquier pantalla.</em>
              </p>
              <span class="round-arrow">↗</span>
            </div>
            <small class="concept-note">
              COMPOSICIÓN CONCEPTUAL · NO ES UN PROYECTO DE CLIENTE
            </small>
          </a>
          <div class="project-info">
            <div>
              <h3>Comercio sin fricción</h3>
              <p>Omni.pro · Desarrollo frontend · 2022 — 2023</p>
            </div>
            <div class="tags">
              <span>Adobe Commerce</span>
              <span>Responsive</span>
              <span>UI</span>
            </div>
          </div>
        </article>
      </section>
      <section class="approach" id="sistema" aria-labelledby="approach-title">
        <div class="section-label">
          <span>NO SOLO CÓDIGO</span>
          <span>UNA VISIÓN COMPLETA</span>
        </div>
        <h2 id="approach-title">
          Lo importante
          <br />
          es cómo <em>encaja.</em>
        </h2>
        <div class="approach-grid">
          <p class="approach-intro">
            Una interfaz clara necesita servicios sólidos. Los servicios
            necesitan datos confiables. Y todo necesita una infraestructura que
            lo sostenga.
          </p>
          <div class="layer-explorer">
            <div class="layer-buttons" aria-label="Explorar capacidades">
              <button data-layer="0" aria-pressed="true">
                <span>01</span> Lo que usas <b>↗</b>
              </button>
              <button data-layer="1" aria-pressed="false">
                <span>02</span> Lo que resuelve <b>↗</b>
              </button>
              <button data-layer="2" aria-pressed="false">
                <span>03</span> Lo que sostiene <b>↗</b>
              </button>
            </div>
            <div class="layer-content" aria-live="polite">
              <span id="layer-name">FRONTEND</span>
              <h3 id="layer-heading">
                La complejidad no tiene que sentirse compleja.
              </h3>
              <p id="layer-description">
                Interfaces responsive y componentes reutilizables, desde
                aplicaciones Angular hasta experiencias de compra en Adobe
                Commerce.
              </p>
              <p id="layer-tech">Angular · TypeScript · HTML · CSS</p>
            </div>
          </div>
        </div>
      </section>
      <section class="about">
        <div class="section-label">
          <span>EL DESARROLLADOR DETRÁS</span>
          <span>TULUÁ, COLOMBIA</span>
        </div>
        <div class="about-grid">
          <h2>
            Jhon
            <br />
            Rengifo<span>↗</span>
          </h2>
          <div>
            <p>
              Ingeniero de Sistemas y desarrollador full stack con más de cuatro
              años de experiencia conectando interfaces, servicios y datos.
            </p>
            <p>
              He trabajado en comercio electrónico, auditoría de peajes e
              interoperabilidad. Me interesa entender el problema completo, no
              únicamente la pantalla que tenemos delante.
            </p>
            <a
              class="text-link"
              href="/cv_mejorada.pdf"
              target="_blank"
              rel="noopener"
            >
              Leer mi CV ↗
            </a>
          </div>
        </div>
      </section>
      <footer id="contacto">
        <div class="section-label">
          <span>LA PRÓXIMA CONEXIÓN</span>
          <span>EMPIEZA CON UNA CONVERSACIÓN</span>
        </div>
        <a class="contact-title" href="mailto:rengifo-vera@hotmail.com">
          HAGAMOS
          <br />
          QUE PASE<span>↗</span>
        </a>
        <div class="footer-bottom">
          <a href="mailto:rengifo-vera@hotmail.com">rengifo-vera@hotmail.com</a>
          <a
            href="https://www.linkedin.com/in/jhon-rengifo-722273217/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>
          <a href="#inicio">Volver arriba ↑</a>
          <span>JHON RENGIFO © {new Date().getFullYear()}</span>
        </div>
      </footer>
    </main>
    <div class="pointer-label" aria-hidden="true">
      EXPLORAR ↗
    </div>
    <script>
      import "../scripts/experience";
    </script>
  </body>
</html>
